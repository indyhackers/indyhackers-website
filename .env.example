# Frontend (Vite) — none required for `npm run dev`; MSW mocks PocketBase (including events).
# Set to false to talk to real PocketBase on localhost:8090 (via Vite proxy). Requires PB running.
# Use `npm run dev:backend` as shorthand. Default: MSW mocks all PocketBase API calls in dev.
# VITE_USE_MSW=true

# --- PocketBase server-side (set on the `pocketbase` container, not Vite) ---
# Production: `docker run --env-file=.env`. Local docker-compose: add under service `environment:`.
# Optional — base URL used to build links in outgoing emails (e.g. the self-service job
# management link). Falls back to PocketBase Settings > Application URL if unset.
SITE_URL=https://indyhackers.com
# Optional — where new-job moderator notifications are sent (falls back to the SMTP sender).
JOB_NOTIFY_EMAIL=
# Optional Slack incoming webhook (PRIVATE moderator channel) — pings for new-job
# submissions, moderator decisions, and pending Slack-invite requests.
SLACK_WEBHOOK_URL=
# Optional Slack incoming webhook for the PUBLIC #jobs channel — an approved job
# is announced here (title, company, link) so members see new openings. Keep this
# separate from SLACK_WEBHOOK_URL so moderator pings don't leak to members.
SLACK_JOBS_WEBHOOK_URL=

# --- Slack join page (/slack) + invite approval queue ---
# Read by the PocketBase backend (pb/hooks/slack.pb.js), NOT the Vite frontend.
# Slack token with admin scope + the *.slack.com subdomain are required to send
# invites. Without RECAPTCHA_SECRET the captcha check is skipped (dev only) —
# set it in production to prevent invite spam.
# SLACK_API_TOKEN=xoxp-...
# SLACK_SUBDOMAIN=indyhackers
# reCAPTCHA v3 (invisible, score-based) — NOT v2. Create a v3 key at
# https://www.google.com/recaptcha/admin/create
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5        # below this, requests go to the review queue
# Where pending-request notifications go (falls back to JOB_NOTIFY_EMAIL, then sender):
# SLACK_REVIEW_EMAIL=board@indyhackers.org
# SLACK_AUTOAPPROVE=on          # "off" sends every request to the review queue
# SLACK_RATE_PER_HOUR=5         # max invite requests per IP per hour
# IP -> ISP/ASN lookup shown in the review card + notifications. URL template
# with an {ip} placeholder; defaults to ipwho.is (HTTPS, no key). Point it at
# ip-api.com / ipinfo.io / ipapi.co (append any key as a query param) to swap
# providers. Best-effort — a failed lookup just leaves the ISP field blank.
# SLACK_ISP_LOOKUP_URL=https://ipwho.is/{ip}
# Legacy slack.indyhackers.org subdomain redirect (pb/hooks/slack_redirect.pb.js).
# Any request whose Host matches SLACK_REDIRECT_HOST is 302'd to SLACK_REDIRECT_TARGET.
# Defaults below are used if unset; override only if the hostnames change.
# SLACK_REDIRECT_HOST=slack.indyhackers.org
# SLACK_REDIRECT_TARGET=https://www.indyhackers.org/slack

# --- Google login (OAuth2) ---
# Read by pb/hooks/oauth.pb.js; configures the Google provider at startup.
# Google Cloud OAuth client redirect URI must be:
#   https://<your-domain>/api/oauth2-redirect
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Event geocoding (calendar map view) ---
# Read by the PocketBase backend (pb/hooks/geocode_util.js), NOT the Vite
# frontend. Each event's free-text `location` is resolved to lat/lng once and
# cached on the row, so the map renders without any browser-side geocoding.
# The map itself uses OpenStreetMap tiles via Leaflet and needs no key.
#
# Provider defaults to `google` when GOOGLE_API_KEY is set, else `nominatim`.
# NOTE: Google's Geocoding API (unlike the Calendar API) requires a billing
# account on the Cloud project. Set GEOCODER_PROVIDER=nominatim to use
# OpenStreetMap's geocoder instead — no key, no billing, capped at 1 req/sec
# (honored automatically).
# GEOCODER_PROVIDER=nominatim
# Contact address put in the User-Agent, as Nominatim's usage policy requires.
# Falls back to JOB_NOTIFY_EMAIL, then the site URL.
# GEOCODER_CONTACT=board@indyhackers.org
# The hourly calendar sync also resolves any upcoming event still missing
# coordinates — including locked and user-submitted events it otherwise skips —
# capped at this many per run so a first-time backlog is spread over several
# runs. To drain one immediately: `pocketbase backfill-geocodes 500`.
# GEOCODE_BACKFILL_LIMIT=50
# Addresses that come back with no match are remembered so they aren't re-asked
# every hour. After switching providers (or enabling a Google key) give them
# another look with: `pocketbase backfill-geocodes 500 retry`.

# --- Google Calendar sync (events) ---
# Read by the PocketBase backend (pb/hooks/calendar_sync.js), NOT the Vite
# frontend. An hourly cron pulls a public Google Calendar into `events`; the
# sync throws (and the cron logs an error) if the first two are unset.
# GOOGLE_API_KEY=              # server-side Google API key with Calendar API enabled
# GOOGLE_CALENDAR_ID=          # the public calendar to sync (e.g. ...@group.calendar.google.com)
# CALENDAR_SYNC_WINDOW_DAYS=90 # how far ahead to sync; defaults to 90
# The window starts at the first of the current month (so the month grid isn't
# blank for days already past) and runs CALENDAR_SYNC_WINDOW_DAYS ahead of now.
#
# Each run also removes synced events the calendar no longer returns: Google
# omits deleted events rather than reporting them cancelled, so absence from the
# feed is the only signal there is. Only unlocked `source: google` rows inside
# that window are ever removed, and nothing is removed if the feed came back
# empty. Set to "off" to disable.
# CALENDAR_PRUNE=off
